model PaymentTransaction {
  id                  Int      @id @default(autoincrement())
  status              String
  orderId             String
  historyId           String
  consumerUnique      String
  authCode            String
  parentId            String
  subId               String
  paymentType         String
  customerName        String
  customerPhone       String
  initialAmount       Float
  billingCycle        Int
  currency            String
  merchantOrderNumber String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
