model AiAnalysis {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAnalysisId   String        @db.Uuid
  documentUrl      String?
  documentPublicId String?
  fileName         String?
  status           String        @default("pending")
  engine           String?
  error            String?
  result           Json?
  processedAt      DateTime?     @db.Timestamp(6)
  processedBy      String?       @db.Uuid
  createdAt        DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?     @default(now()) @updatedAt @db.Timestamp(6)
  BankAnalysis     BankAnalysis  @relation(fields: [bankAnalysisId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bankAnalysisId])
}

model McaTag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String    @unique
  decision  String
  example   String?
  createdBy String?   @db.Uuid
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  @@index([key])
}
