{
  "name": "ih-crm-be",
  "version": "1.0.0",
  "description": "IH CRM Backend - A TypeScript-based CRM solution",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm install && npx prisma generate && tsc && node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','services','docusign','layouts','assets');const dest=path.join('dist','services','docusign','layouts','assets');if(fs.existsSync(src)){fs.mkdirSync(dest,{recursive:true});for(const f of fs.readdirSync(src)){fs.copyFileSync(path.join(src,f),path.join(dest,f));}}\"",
    "dev": "npx prisma generate && set NODE_OPTIONS=--max-old-space-size=4096 && set TS_NODE_TRANSPILE_ONLY=true && nodemon --config nodemon.json src/index.ts",
    "postinstall": "npx prisma generate",
    "start": "node dist/index.js",
    "seed:payoff-template": "npx ts-node src/scripts/seedPayoffWireTemplate.ts",
    "seed:super-admin": "ts-node src/scripts/seedSuperAdmin.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "crm",
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/xai": "^3.0.67",
