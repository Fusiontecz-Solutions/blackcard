    "@google-cloud/documentai": "^8.12.0",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.0.2",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-neon": "^7.3.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.2",
    "boldsign": "^3.1.2",
    "bullmq": "^5.76.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dot": "^1.1.3",
